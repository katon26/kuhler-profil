# Maintainer: Katon <katonadams.f@gmail.com>
pkgname=kuhlerprofil
pkgver=0.1.0
pkgrel=1
pkgdesc="ASUS Linux thermal profile governor, fan curves, and battery health guardian"
arch=('x86_64')
url="https://github.com/katon26/kuhler-profil"
license=('MIT')
depends=('dbus' 'systemd')
makedepends=('go' 'make')
backup=('etc/kuhlerprofil/config.toml')
install=kuhlerprofil.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/kuhler-profil-$pkgver" || cd "$srcdir/$pkgname-$pkgver"
    make build
}

package() {
    cd "$srcdir/kuhler-profil-$pkgver" || cd "$srcdir/$pkgname-$pkgver"
    
    install -Dm755 bin/kuhlerprofild "$pkgdir/usr/bin/kuhlerprofild"
    install -Dm755 bin/kuhlerprofil "$pkgdir/usr/bin/kuhlerprofil"
    ln -s kuhlerprofil "$pkgdir/usr/bin/kp"
    ln -s kuhlerprofil "$pkgdir/usr/bin/kuhler"

    install -Dm644 systemd/kuhlerprofil.service "$pkgdir/usr/lib/systemd/system/kuhlerprofil.service"
    install -Dm644 systemd/org.freedesktop.kuhlerprofil.conf "$pkgdir/usr/share/dbus-1/system.d/org.freedesktop.kuhlerprofil.conf"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
